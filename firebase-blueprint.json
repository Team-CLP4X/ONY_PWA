{
  "schemaVersion": 2,
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile, personalization settings, profile details, and consent preferences.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string", "maxLength": 40 },
        "bio": { "type": "string", "maxLength": 300 },
        "pronouns": { "type": "string", "maxLength": 40 },
        "ageRange": { "type": "string", "maxLength": 40 },
        "avatarType": { "type": "string", "enum": ["preset", "photo"] },
        "presetAvatar": { "type": "string", "maxLength": 30 },
        "avatarUrl": { "type": "string", "maxLength": 1500 },
        "subscriptionStatus": { "type": "string", "enum": ["free", "payg", "monthly"] },
        "theme": { "type": "string", "enum": ["peach", "ocean", "sunset", "forest", "lavender", "neutral"] },
        "companion": { "type": "string", "enum": ["Cat", "Dog", "Bunny", "Bear", "Fox", "Panda"] },
        "persona": { "type": "string", "enum": ["gentle", "friendly", "calm"] },
        "preferredLanguage": { "type": "string", "enum": ["English", "Bahasa Melayu", "中文"] },
        "conversationStyle": { "type": "string", "enum": ["Reflective", "Practical", "A mix"] },
        "responseLength": { "type": "string", "enum": ["Short", "Balanced", "Detailed"] },
        "memoryConsent": { "type": "string", "enum": ["allow", "control"] },
        "useActiveMemories": { "type": "boolean" },
        "chatViewMode": { "type": "string", "enum": ["companion", "classic"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "email", "theme", "companion", "persona", "preferredLanguage"]
    },
    "MoodCheckin": {
      "title": "MoodCheckin",
      "description": "User emotional check-in record saved per day (YYYY-MM-DD).",
      "type": "object",
      "properties": {
        "dateKey": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "level": { "type": "number", "minimum": 1, "maximum": 5 },
        "emoji": { "type": "string" },
        "label": { "type": "string" },
        "note": { "type": "string", "maxLength": 500 },
        "reportAllowed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["dateKey", "level", "emoji", "label", "createdAt"]
    },
    "Memory": {
      "title": "Memory",
      "description": "Consented, user-controlled memory item used for reflection and optional context.",
      "type": "object",
      "properties": {
        "text": { "type": "string", "maxLength": 300 },
        "reason": { "type": "string", "maxLength": 200 },
        "category": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "active", "createdAt"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Private personal digital diary entry with date, title, reflection body, mood tags, and Firebase Storage photo URL.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "content": { "type": "string", "maxLength": 5000 },
        "dateKey": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "entryDate": { "type": "string", "format": "date-time" },
        "moodEmoji": { "type": "string", "maxLength": 10 },
        "moodLabel": { "type": "string", "maxLength": 40 },
        "photoUrl": { "type": "string", "maxLength": 1500 },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "dateKey", "entryDate", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Chat session metadata and history.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "category": { "type": "string" },
        "folderId": { "type": "number" },
        "reportAllowed": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": { "type": "string", "enum": ["user", "ony"] },
              "text": { "type": "string", "maxLength": 2000 }
            },
            "required": ["from", "text"]
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "messages", "updatedAt"]
    },
    "GlobeUser": {
      "title": "GlobeUser",
      "description": "Anonymous discovery globe node owned by a single authenticated user (`globeUsers/{uid}`).",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "ownerUid": { "type": "string" },
        "moodGlow": { "type": "string", "enum": ["bright", "soft", "dim", "neutral"] },
        "moodLabel": { "type": "string", "maxLength": 50 },
        "discoverable": { "type": "boolean" },
        "acceptsMessages": { "type": "boolean" },
        "minLevel": { "type": "number" },
        "lon": { "type": "number" },
        "lat": { "type": "number" },
        "regionName": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "moodGlow", "moodLabel", "discoverable", "acceptsMessages", "minLevel", "lon", "lat"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Community posts shared across categories with reactions, media URLs, comments, and replies.",
      "type": "object",
      "properties": {
        "author": { "type": "string", "maxLength": 50 },
        "authorId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 4000 },
        "category": { "type": "string", "maxLength": 50 },
        "likes": { "type": "number", "minimum": 0 },
        "likeRecords": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "userId": { "type": "string" },
              "userName": { "type": "string" },
              "reaction": { "type": "string", "maxLength": 20 },
              "createdAt": { "type": "string", "format": "date-time" }
            },
            "required": ["userId", "userName", "createdAt"]
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "userId": { "type": "string" },
              "userName": { "type": "string" },
              "text": { "type": "string", "maxLength": 1000 },
              "audioUrl": { "type": "string" },
              "audioDuration": { "type": "number" },
              "createdAt": { "type": "string", "format": "date-time" },
              "updatedAt": { "type": "string", "format": "date-time" },
              "likes": { "type": "number", "minimum": 0 },
              "likeRecords": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "userId": { "type": "string" },
                    "userName": { "type": "string" },
                    "createdAt": { "type": "string", "format": "date-time" }
                  },
                  "required": ["userId", "userName", "createdAt"]
                }
              },
              "replies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "userId": { "type": "string" },
                    "userName": { "type": "string" },
                    "text": { "type": "string", "maxLength": 1000 },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                  },
                  "required": ["id", "userId", "userName", "text", "createdAt"]
                }
              }
            },
            "required": ["id", "userId", "userName", "text", "createdAt"]
          }
        },
        "media": { "type": "string", "enum": ["image", "voice", "text"] },
        "imageUrl": { "type": "string", "maxLength": 1500 },
        "audioUrl": { "type": "string", "maxLength": 1500 },
        "audioDuration": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["author", "authorId", "title", "body", "category", "likes", "createdAt"]
    },
    "Merchant": {
      "title": "Merchant",
      "description": "Verified wellness and discovery voucher providers managed by server/admin tooling.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "offer": { "type": "string", "maxLength": 100 },
        "value": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "image": { "type": "string" },
        "validity": { "type": "string", "maxLength": 100 },
        "active": { "type": "boolean" },
        "expired": { "type": "boolean" }
      },
      "required": ["name", "category", "offer", "value", "description", "image", "validity"]
    },
    "CommunityMessage": {
      "title": "CommunityMessage",
      "description": "Anonymous peer encouragement message (text or voice) readable only by sender and recipient.",
      "type": "object",
      "properties": {
        "toUserId": { "type": "string", "maxLength": 128 },
        "toUserMood": { "type": "string", "maxLength": 100 },
        "fromUserId": { "type": "string", "maxLength": 128 },
        "senderAnonymous": { "type": "string", "maxLength": 100 },
        "recipientAnonymous": { "type": "string", "maxLength": 100 },
        "kind": { "type": "string", "enum": ["text", "voice"] },
        "text": { "type": "string", "maxLength": 2000 },
        "audioUrl": { "type": "string", "maxLength": 1500 },
        "audioDuration": { "type": "number" },
        "transcript": { "type": "string", "maxLength": 2000 },
        "isRead": { "type": "boolean" },
        "readAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["toUserId", "fromUserId", "senderAnonymous", "recipientAnonymous", "kind", "text", "createdAt"]
    },
    "UserDirectory": {
      "title": "UserDirectory",
      "description": "Minimal registered user directory record enabling exact trusted-contact lookup without exposing private user data.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 50 },
        "displayNameLower": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "format": "email" },
        "emailLower": { "type": "string", "maxLength": 120 },
        "phoneNumber": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "emailLower", "updatedAt"]
    },
    "TrustedContactRequest": {
      "title": "TrustedContactRequest",
      "description": "Trusted contact invitation or link-based emergency contact request between registered ONY users.",
      "type": "object",
      "properties": {
        "fromUid": { "type": "string", "maxLength": 128 },
        "fromName": { "type": "string", "maxLength": 50 },
        "fromEmail": { "type": "string", "format": "email" },
        "fromEmailLower": { "type": "string", "maxLength": 120 },
        "toUid": { "type": "string", "maxLength": 128 },
        "toName": { "type": "string", "maxLength": 50 },
        "toEmail": { "type": "string", "format": "email" },
        "toEmailLower": { "type": "string", "maxLength": 120 },
        "contactPhone": { "type": "string", "maxLength": 40 },
        "relationshipNote": { "type": "string", "maxLength": 300 },
        "requestKind": { "type": "string", "enum": ["direct_invite", "invite_link"] },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "respondedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fromUid", "fromName", "fromEmail", "toUid", "toName", "toEmail", "status", "createdAt", "updatedAt"]
    },
    "UserAuditLog": {
      "title": "UserAuditLog",
      "description": "Owner-scoped security and account activity log under users/{userId}/auditLogs.",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "level": { "type": "string", "enum": ["info", "warn", "error", "security", "audit"] },
        "category": { "type": "string", "maxLength": 50 },
        "action": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 2000 },
        "userId": { "type": "string", "maxLength": 128 },
        "metadata": { "type": "object" }
      },
      "required": ["timestamp", "level", "category", "action", "message", "userId"]
    },
    "SavedPostRef": {
      "title": "SavedPostRef",
      "description": "Owner-private bookmarked post reference.",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "savedAt"]
    },
    "HiddenPostRef": {
      "title": "HiddenPostRef",
      "description": "Owner-private hidden post reference.",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "hiddenAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "hiddenAt"]
    },
    "BlockedUserRef": {
      "title": "BlockedUserRef",
      "description": "Owner-private blocked anonymous node/user record.",
      "type": "object",
      "properties": {
        "blockedUid": { "type": "string" },
        "blockedAt": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "maxLength": 300 }
      },
      "required": ["blockedUid", "blockedAt"]
    },
    "VoucherClaim": {
      "title": "VoucherClaim",
      "description": "Owner-private marketplace voucher claim record.",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "merchantName": { "type": "string" },
        "offer": { "type": "string" },
        "value": { "type": "string" },
        "voucherCode": { "type": "string" },
        "claimedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["claimed", "redeemed"] }
      },
      "required": ["merchantId", "merchantName", "voucherCode", "claimedAt", "status"]
    },
    "ToolkitCompletion": {
      "title": "ToolkitCompletion",
      "description": "Owner-private self-help coping toolkit completion log.",
      "type": "object",
      "properties": {
        "toolId": { "type": "string" },
        "title": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["toolId", "title", "completedAt"]
    },
    "ModerationReport": {
      "title": "ModerationReport",
      "description": "User-submitted safety or moderation report for posts, comments, or community messages.",
      "type": "object",
      "properties": {
        "reporterUid": { "type": "string" },
        "targetType": { "type": "string", "enum": ["post", "comment", "message", "node"] },
        "targetId": { "type": "string" },
        "targetAuthorId": { "type": "string" },
        "reason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterUid", "targetType", "targetId", "reason", "createdAt"]
    },
    "FeedbackReport": {
      "title": "FeedbackReport",
      "description": "User-submitted bug report or product feedback with optional Firebase Storage screenshot URL.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "category": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 2000 },
        "screenshotUrl": { "type": "string", "maxLength": 1500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "category", "description", "createdAt"]
    },
    "VaultShelf": {
      "title": "VaultShelf",
      "description": "A shelf in the Memory Vault organizing books by topic.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "color": { "type": "string" },
        "order": { "type": "number" },
        "isLocked": { "type": "boolean" },
        "aiRecallEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "order", "createdAt", "updatedAt"]
    },
    "VaultBook": {
      "title": "VaultBook",
      "description": "A journal book residing on a vault shelf containing personal pages.",
      "type": "object",
      "properties": {
        "shelfId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "coverColor": { "type": "string" },
        "pageTexture": { "type": "string", "enum": ["ruled", "dots", "blank"] },
        "pageCount": { "type": "number" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shelfId", "title", "coverColor", "createdAt", "updatedAt"]
    },
    "VaultPage": {
      "title": "VaultPage",
      "description": "An individual written page inside a vault book with rich/plain text, mood, tags, and Storage photos.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "bookId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "content": { "type": "string", "maxLength": 10000 },
        "plainText": { "type": "string", "maxLength": 10000 },
        "searchText": { "type": "string", "maxLength": 10000 },
        "mood": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "photos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "bookId", "createdAt", "updatedAt"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User persistent theme mode, color palette, typography font scale, companion preferences, notification preferences, UI state, and app lock controls.",
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number" },
        "userId": { "type": "string" },
        "colorTheme": { "type": "string", "enum": ["peach", "ocean", "sunset", "forest", "lavender", "neutral"] },
        "themeMode": { "type": "string", "enum": ["light", "dark", "system"] },
        "fontSizeScale": { "type": "string", "enum": ["small", "default", "large", "extraLarge"] },
        "fontSizePercent": { "type": "number" },
        "chatViewMode": { "type": "string", "enum": ["companion", "classic"] },
        "postsViewMode": { "type": "string", "enum": ["desk", "feed", "list"] },
        "language": { "type": "string" },
        "autoTranslateMessages": { "type": "boolean" },
        "seenPostIds": { "type": "array", "items": { "type": "string" } },
        "recentColors": { "type": "array", "items": { "type": "string" } },
        "readNotificationIds": { "type": "array", "items": { "type": "string" } },
        "companionPreferences": { "type": "object" },
        "notificationPreferences": { "type": "object" },
        "soundHapticsPreferences": { "type": "object" },
        "appLockPreferences": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schemaVersion", "colorTheme", "themeMode", "fontSizeScale", "updatedAt"]
    }
  },
  "firestore": {
    "/user_settings/{userId}": {
      "schema": "UserSettings",
      "description": "Stores user appearance, theme, typography scaling, notification, and companion preferences."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Owner-private user profiles, preferences, and consent controls."
    },
    "/users/{userId}/vaultShelves/{shelfId}": {
      "schema": "VaultShelf",
      "description": "Owner-private Memory Vault shelves."
    },
    "/users/{userId}/vaultBooks/{bookId}": {
      "schema": "VaultBook",
      "description": "Owner-private Memory Vault books."
    },
    "/users/{userId}/vaultBooks/{bookId}/pages/{pageId}": {
      "schema": "VaultPage",
      "description": "Owner-private Memory Vault pages inside books."
    },
    "/users/{userId}/moodCheckins/{checkinId}": {
      "schema": "MoodCheckin",
      "description": "Owner-private daily mood check-in entries."
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": "Memory",
      "description": "Owner-private user-managed memory context items."
    },
    "/users/{userId}/journalEntries/{entryId}": {
      "schema": "JournalEntry",
      "description": "Owner-private personal diary and journal reflection entries."
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Owner-private conversation history."
    },
    "/users/{userId}/savedPosts/{postId}": {
      "schema": "SavedPostRef",
      "description": "Owner-private bookmarked community post references."
    },
    "/users/{userId}/hiddenPosts/{postId}": {
      "schema": "HiddenPostRef",
      "description": "Owner-private hidden community post references."
    },
    "/users/{userId}/blockedUsers/{blockedUid}": {
      "schema": "BlockedUserRef",
      "description": "Owner-private blocked community users/nodes."
    },
    "/users/{userId}/voucherClaims/{claimId}": {
      "schema": "VoucherClaim",
      "description": "Owner-private claimed wellness partner vouchers."
    },
    "/users/{userId}/toolkitCompletions/{completionId}": {
      "schema": "ToolkitCompletion",
      "description": "Owner-private completed toolkit activities."
    },
    "/users/{userId}/auditLogs/{logId}": {
      "schema": "UserAuditLog",
      "description": "Owner-private account security and activity audit logs."
    },
    "/globeUsers/{nodeId}": {
      "schema": "GlobeUser",
      "description": "Anonymous globe discovery nodes keyed by user UID."
    },
    "/communityPosts/{postId}": {
      "schema": "CommunityPost",
      "description": "Authenticated community posts feed, reactions, comments, and replies."
    },
    "/merchants/{merchantId}": {
      "schema": "Merchant",
      "description": "Read-only curated wellness merchants and voucher offerings."
    },
    "/communityMessages/{messageId}": {
      "schema": "CommunityMessage",
      "description": "Peer encouragement messages readable strictly by sender and recipient."
    },
    "/userDirectory/{userId}": {
      "schema": "UserDirectory",
      "description": "Limited registered account lookup records for trusted contact matching."
    },
    "/trustedContactRequests/{requestId}": {
      "schema": "TrustedContactRequest",
      "description": "Trusted contact requests readable and editable only by sender or recipient."
    },
    "/moderationReports/{reportId}": {
      "schema": "ModerationReport",
      "description": "User-submitted safety/moderation reports."
    },
    "/feedbackReports/{reportId}": {
      "schema": "FeedbackReport",
      "description": "User-submitted app feedback and bug reports."
    }
  }
}
