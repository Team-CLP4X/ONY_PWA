{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile, personalization settings, and consent preferences.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string", "maxLength": 40 },
        "theme": { "type": "string", "enum": ["peach", "ocean", "sunset", "forest", "lavender", "neutral"] },
        "companion": { "type": "string", "enum": ["Cat", "Dog", "Bunny", "Bear", "Fox", "Panda"] },
        "persona": { "type": "string", "enum": ["gentle", "friendly", "calm"] },
        "preferredLanguage": { "type": "string", "enum": ["English", "Bahasa Melayu", "中文"] },
        "conversationStyle": { "type": "string", "enum": ["Reflective", "Practical", "A mix"] },
        "responseLength": { "type": "string", "enum": ["Short", "Balanced", "Detailed"] },
        "memoryConsent": { "type": "string", "enum": ["allow", "control"] },
        "useActiveMemories": { "type": "boolean" },
        "chatViewMode": { "type": "string", "enum": ["companion", "classic"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "email", "theme", "companion", "persona", "preferredLanguage"]
    },
    "MoodCheckin": {
      "title": "MoodCheckin",
      "description": "User emotional check-in record saved per day (YYYY-MM-DD).",
      "type": "object",
      "properties": {
        "dateKey": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "level": { "type": "number", "minimum": 1, "maximum": 5 },
        "emoji": { "type": "string" },
        "label": { "type": "string" },
        "note": { "type": "string", "maxLength": 500 },
        "reportAllowed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["dateKey", "level", "emoji", "label", "createdAt"]
    },
    "Memory": {
      "title": "Memory",
      "description": "Consented, user-controlled memory item used for reflection and optional context.",
      "type": "object",
      "properties": {
        "text": { "type": "string", "maxLength": 300 },
        "reason": { "type": "string", "maxLength": 200 },
        "category": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "active", "createdAt"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Private personal digital diary entry with date, title, reflection body, optional mood tags, tags, and photo attachment.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "content": { "type": "string", "maxLength": 5000 },
        "dateKey": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "entryDate": { "type": "string", "format": "date-time" },
        "moodEmoji": { "type": "string", "maxLength": 10 },
        "moodLabel": { "type": "string", "maxLength": 40 },
        "photoUrl": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "dateKey", "entryDate", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Chat session metadata and history.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "category": { "type": "string" },
        "folderId": { "type": "number" },
        "reportAllowed": { "type": "boolean" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": { "type": "string", "enum": ["user", "ony"] },
              "text": { "type": "string", "maxLength": 2000 }
            },
            "required": ["from", "text"]
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "messages", "updatedAt"]
    },
    "GlobeUser": {
      "title": "GlobeUser",
      "description": "Anonymous discovery globe node representing opted-in or simulated users across regions.",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "moodGlow": { "type": "string", "enum": ["bright", "soft", "dim", "neutral"] },
        "moodLabel": { "type": "string", "maxLength": 50 },
        "discoverable": { "type": "boolean" },
        "acceptsMessages": { "type": "boolean" },
        "minLevel": { "type": "number" },
        "lon": { "type": "number" },
        "lat": { "type": "number" }
      },
      "required": ["id", "moodGlow", "moodLabel", "discoverable", "acceptsMessages", "minLevel", "lon", "lat"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Community posts shared gently across categories, including likes with user and timestamp, comments with user, timestamp, and likes, and replies to comments with user and timestamp.",
      "type": "object",
      "properties": {
        "author": { "type": "string", "maxLength": 50 },
        "authorId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "body": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 50 },
        "likes": { "type": "number", "minimum": 0 },
        "likeRecords": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "userId": { "type": "string" },
              "userName": { "type": "string" },
              "createdAt": { "type": "string", "format": "date-time" }
            },
            "required": ["userId", "userName", "createdAt"]
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "userId": { "type": "string" },
              "userName": { "type": "string" },
              "text": { "type": "string", "maxLength": 1000 },
              "createdAt": { "type": "string", "format": "date-time" },
              "updatedAt": { "type": "string", "format": "date-time" },
              "likes": { "type": "number", "minimum": 0 },
              "likeRecords": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "userId": { "type": "string" },
                    "userName": { "type": "string" },
                    "createdAt": { "type": "string", "format": "date-time" }
                  },
                  "required": ["userId", "userName", "createdAt"]
                }
              },
              "replies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "userId": { "type": "string" },
                    "userName": { "type": "string" },
                    "text": { "type": "string", "maxLength": 1000 },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                  },
                  "required": ["id", "userId", "userName", "text", "createdAt"]
                }
              }
            },
            "required": ["id", "userId", "userName", "text", "createdAt"]
          }
        },
        "media": { "type": "string", "enum": ["image", "voice", "text"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["author", "title", "body", "category", "likes", "createdAt"]
    },
    "Merchant": {
      "title": "Merchant",
      "description": "Wellness and discovery voucher providers.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "offer": { "type": "string", "maxLength": 100 },
        "value": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "image": { "type": "string" },
        "validity": { "type": "string", "maxLength": 100 }
      },
      "required": ["name", "category", "offer", "value", "description", "image", "validity"]
    },
    "CommunityMessage": {
      "title": "CommunityMessage",
      "description": "Anonymous support message (text or voice) sent between community members.",
      "type": "object",
      "properties": {
        "toUserId": { "type": "string", "maxLength": 100 },
        "toUserMood": { "type": "string", "maxLength": 100 },
        "fromUserId": { "type": "string", "maxLength": 100 },
        "senderAnonymous": { "type": "string", "maxLength": 100 },
        "recipientAnonymous": { "type": "string", "maxLength": 100 },
        "kind": { "type": "string", "enum": ["text", "voice"] },
        "text": { "type": "string", "maxLength": 2000 },
        "audioUrl": { "type": "string" },
        "audioDuration": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["toUserId", "fromUserId", "senderAnonymous", "recipientAnonymous", "kind", "text", "createdAt"]
    },
    "UserDirectory": {
      "title": "UserDirectory",
      "description": "Directory of registered ONY accounts for verifying and looking up trusted contacts.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "format": "email" },
        "emailLower": { "type": "string", "maxLength": 120 },
        "phoneNumber": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "emailLower", "updatedAt"]
    },
    "TrustedContactRequest": {
      "title": "TrustedContactRequest",
      "description": "Trusted contact invitation or link-based emergency contact request between registered ONY users, supporting pending, accepted, and rejected states.",
      "type": "object",
      "properties": {
        "fromUid": { "type": "string", "maxLength": 128 },
        "fromName": { "type": "string", "maxLength": 50 },
        "fromEmail": { "type": "string", "format": "email" },
        "toUid": { "type": "string", "maxLength": 128 },
        "toName": { "type": "string", "maxLength": 50 },
        "toEmail": { "type": "string", "format": "email" },
        "contactPhone": { "type": "string", "maxLength": 40 },
        "relationshipNote": { "type": "string", "maxLength": 300 },
        "requestKind": { "type": "string", "enum": ["direct_invite", "invite_link"] },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "respondedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fromUid", "fromName", "fromEmail", "toUid", "toName", "toEmail", "status", "createdAt", "updatedAt"]
    },
    "SystemLog": {
      "title": "SystemLog",
      "description": "Production audit and system event logs recorded in Firestore for security, compliance, error tracing, and activity monitoring.",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "level": { "type": "string", "enum": ["info", "warn", "error", "security", "audit"] },
        "category": { "type": "string", "maxLength": 50 },
        "action": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 2000 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 120 },
        "clientInfo": {
          "type": "object",
          "properties": {
            "platform": { "type": "string" },
            "userAgent": { "type": "string", "maxLength": 300 },
            "version": { "type": "string" }
          }
        },
        "metadata": { "type": "object" }
      },
      "required": ["timestamp", "level", "category", "action", "message"]
    },
    "VaultShelf": {
      "title": "VaultShelf",
      "description": "A shelf in the Memory Vault organizing books by topic.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "color": { "type": "string" },
        "order": { "type": "number" },
        "isLocked": { "type": "boolean" },
        "aiRecallEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "order", "createdAt", "updatedAt"]
    },
    "VaultBook": {
      "title": "VaultBook",
      "description": "A journal book residing on a vault shelf containing personal pages.",
      "type": "object",
      "properties": {
        "shelfId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "coverColor": { "type": "string" },
        "pageTexture": { "type": "string", "enum": ["ruled", "dots", "blank"] },
        "pageCount": { "type": "number" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shelfId", "title", "coverColor", "createdAt", "updatedAt"]
    },
    "VaultPage": {
      "title": "VaultPage",
      "description": "An individual written page inside a vault book with rich/plain text, mood, tags, and photos.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "bookId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "content": { "type": "string", "maxLength": 10000 },
        "plainText": { "type": "string", "maxLength": 10000 },
        "searchText": { "type": "string", "maxLength": 10000 },
        "mood": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "photos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "bookId", "createdAt", "updatedAt"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User persistent theme mode, color palette, typography font scale, companion preferences, notification settings, and app lock controls.",
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number" },
        "userId": { "type": "string" },
        "colorTheme": { "type": "string", "enum": ["peach", "ocean", "sunset", "forest", "lavender", "neutral"] },
        "themeMode": { "type": "string", "enum": ["light", "dark", "system"] },
        "fontSizeScale": { "type": "string", "enum": ["small", "default", "large", "extraLarge"] },
        "fontSizePercent": { "type": "number" },
        "chatViewMode": { "type": "string", "enum": ["companion", "classic"] },
        "postsViewMode": { "type": "string", "enum": ["feed", "list"] },
        "language": { "type": "string" },
        "companionPreferences": { "type": "object" },
        "notificationPreferences": { "type": "object" },
        "soundHapticsPreferences": { "type": "object" },
        "appLockPreferences": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schemaVersion", "colorTheme", "themeMode", "fontSizeScale", "updatedAt"]
    }
  },
  "firestore": {
    "/user_settings/{userId}": {
      "schema": "UserSettings",
      "description": "Stores user appearance, theme, typography scaling, notification, and companion preferences."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles, preferences, and consent controls."
    },
    "/users/{userId}/vaultShelves/{shelfId}": {
      "schema": "VaultShelf",
      "description": "Stores user Memory Vault shelves."
    },
    "/users/{userId}/vaultBooks/{bookId}": {
      "schema": "VaultBook",
      "description": "Stores user Memory Vault books."
    },
    "/users/{userId}/vaultBooks/{bookId}/pages/{pageId}": {
      "schema": "VaultPage",
      "description": "Stores user Memory Vault pages inside books."
    },
    "/users/{userId}/moodCheckins/{checkinId}": {
      "schema": "MoodCheckin",
      "description": "Stores private mood entries per user."
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": "Memory",
      "description": "Stores user-managed context and memory vault items."
    },
    "/users/{userId}/journalEntries/{entryId}": {
      "schema": "JournalEntry",
      "description": "Stores private personal diary and journal reflection entries per user."
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Stores conversation history per user."
    },
    "/globeUsers/{nodeId}": {
      "schema": "GlobeUser",
      "description": "Stores anonymous globe presence nodes for community discovery."
    },
    "/communityPosts/{postId}": {
      "schema": "CommunityPost",
      "description": "Stores community feed posts and reflections."
    },
    "/merchants/{merchantId}": {
      "schema": "Merchant",
      "description": "Stores discoverable wellness merchants and voucher offerings."
    },
    "/communityMessages/{messageId}": {
      "schema": "CommunityMessage",
      "description": "Stores supportive anonymous messages between community members."
    },
    "/userDirectory/{userId}": {
      "schema": "UserDirectory",
      "description": "Stores registered ONY user directory entries so users can verify accounts when sending trusted contact requests."
    },
    "/trustedContactRequests/{requestId}": {
      "schema": "TrustedContactRequest",
      "description": "Stores trusted contact requests between registered ONY users with pending, accepted, and rejected statuses."
    },
    "/systemLogs/{logId}": {
      "schema": "SystemLog",
      "description": "Stores production application activity logs, security audit events, and system diagnostic records in Firestore."
    }
  }
}
