rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile and settings
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Subcollection: Mood check-ins
      match /moodCheckins/{checkinId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: Memory Vault
      match /memories/{memoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: Conversations
      match /conversations/{conversationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Community Globe nodes (Anonymous presence nodes)
    match /globeUsers/{nodeId} {
      allow read, write: if true;
    }

    // Community Posts feed (Read, Create, Like/Update, Delete)
    match /communityPosts/{postId} {
      allow read, write: if true;
    }

    // Marketplace merchants and wellness vouchers
    match /merchants/{merchantId} {
      allow read, write: if true;
    }

    // Community support messages (Anonymous peer encouragement text/voice)
    match /communityMessages/{messageId} {
      allow read, write: if true;
    }
  }
}
