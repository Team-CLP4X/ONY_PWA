rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile and settings
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      // All subcollections belonging to this user (vaultShelves, vaultBooks, pages, moodCheckins, memories, conversations, etc.)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Dedicated User Settings collection keyed by userId
    match /user_settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Collection group query for pages owned by the authenticated user
    match /{path=**}/pages/{pageId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Community Globe nodes (Anonymous presence nodes)
    match /globeUsers/{nodeId} {
      allow read, write: if true;
    }

    // Community Posts feed (Read, Create, Like/Update, Comment, Reply, Delete)
    match /communityPosts/{postId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Marketplace merchants and wellness vouchers
    match /merchants/{merchantId} {
      allow read, write: if true;
    }

    // Community support messages (Anonymous peer encouragement text/voice)
    match /communityMessages/{messageId} {
      allow read, write: if true;
    }

    // Registered user directory for Trusted Contact account lookup
    match /userDirectory/{userId} {
      allow read, write: if true;
    }

    // Trusted contact requests between registered users
    match /trustedContactRequests/{requestId} {
      allow read, write: if true;
    }

    // System audit & production activity logs
    match /systemLogs/{logId} {
      allow read, write: if true;
    }
  }
}
